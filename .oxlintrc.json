{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc"],
	"categories": {
		"correctness": "error"
	},
	"env": {
		"builtin": true,
		"browser": true,
		"es2024": true
	},
	"ignorePatterns": [
		"dist",
		"classmaps",
		"packages/kit/vendor",
		"modules/stdlib/vendor",
		"spicetify.d.ts",
		"platform.d.ts",
		"**/*.gen.ts",
		"**/CODEGEN.ts",
		"**/classmap.d.ts"
	],
	"rules": {
		"no-unused-vars": [
			"error",
			{
				"argsIgnorePattern": "^_",
				"varsIgnorePattern": "^_",
				"caughtErrors": "none"
			}
		],
		"no-this-alias": "warn",
		"no-useless-escape": "warn",
		"no-undef": "error"
	},
	"globals": {
		"Spicetify": "readonly",
		"MAP": "readonly",
		"CHUNKS": "readonly"
	},
	"overrides": [
		{
			"files": ["scripts/**", "packages/**", "**/*.mts", "**/*.mjs", "modules/*/lib/**"],
			"env": {
				"node": true
			}
		}
	]
}
