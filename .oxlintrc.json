{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc"],
	"categories": {
		"correctness": "error"
	},
	"env": {
		"builtin": true,
		"browser": true,
		"es2024": true
	},
	"ignorePatterns": [
		"dist",
		"classmaps",
		"packages/kit/vendor",
		"spicetify.d.ts",
		"**/*.gen.ts",
		"**/CODEGEN.ts",
		"**/classmap.d.ts"
	],
	"rules": {
		"no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrors": "none" }],
		"no-this-alias": "warn",
		"no-useless-escape": "warn"
	}
}
