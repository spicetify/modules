{
	"name": "@spicetify/kit",
	"version": "0.3.0",
	"description": "Developer kit for spicetify v3 modules: scaffold, build, hot-push, and pack",
	"license": "GPL-3.0-or-later",
	"homepage": "https://github.com/spicetify/modules#readme",
	"bugs": {
		"url": "https://github.com/spicetify/modules/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spicetify/modules.git",
		"directory": "packages/kit"
	},
	"type": "module",
	"bin": {
		"spicetify-kit": "bin/spicetify-kit.js"
	},
	"exports": {
		".": "./dist/cli.js",
		"./create": "./dist/create.js",
		"./build": "./dist/build.js",
		"./dev": "./dist/dev.js",
		"./pack": "./dist/pack.js",
		"./from-theme": "./dist/from-theme.js",
		"./check": "./dist/check.js",
		"./vault": "./dist/vault.js",
		"./install": "./dist/install.js"
	},
	"files": [
		"bin",
		"dist",
		"vendor"
	],
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public"
	},
	"spicetify": {
		"stdlibVersion": "1.10.4"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "node --test \"test/*.test.mts\"",
		"prepack": "node scripts/sync-vendor.ts && tsc -p tsconfig.build.json"
	},
	"dependencies": {
		"rolldown": "^1.2.0",
		"sass-embedded": "^1.80.0"
	}
}
