{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 4,
	"printWidth": 120,
	"semi": true,
	"singleQuote": false,
	"trailingComma": "all",
	"ignorePatterns": [
		"dist",
		"classmaps",
		"packages/kit/vendor",
		"modules/stdlib/vendor",
		"spicetify.d.ts",
		"platform.d.ts",
		"**/classmap.d.ts",
		"**/*.gen.ts",
		"**/CODEGEN.ts",
		"**/package.json",
		"**/CHANGELOG.md",
		"pnpm-lock.yaml",
		".github",
		"**/*.yml",
		"**/*.yaml"
	]
}
