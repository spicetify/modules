#!/bin/sh
# Formats staged files with oxfmt and re-stages them, then lints them, so a
# commit can never fail CI's format or lint job. `nub run check` is tsc plus
# oxlint and does not format, which is exactly how unformatted code reached
# main before; a dead type alias later reached it the same way through lint.
#
# Caveat: a file staged only in part gets its unstaged changes staged too,
# because the formatter rewrites the whole working file. Commit partial
# hunks with --no-verify and format by hand.
set -e

fmt=./node_modules/.bin/oxfmt
[ -x "$fmt" ] || exit 0

staged=$(git diff --cached --name-only --diff-filter=ACMR -z | tr '\0' '\n' |
	grep -E '\.(ts|tsx|mts|cts|js|jsx|mjs|json|scss)$' || true)
[ -z "$staged" ] && exit 0

# oxfmt exits non-zero when every path it was given is ignored (.oxfmtrc),
# which is a normal commit, not a failure. Anything else is real.
out=$(printf '%s\n' "$staged" | tr '\n' '\0' | xargs -0 "$fmt" 2>&1) || {
	case "$out" in
	*"Expected at least one target file"*) exit 0 ;;
	*) printf '%s\n' "$out" >&2; exit 1 ;;
	esac
}

printf '%s\n' "$staged" | tr '\n' '\0' | xargs -0 git add

lint=./node_modules/.bin/oxlint
[ -x "$lint" ] || exit 0

# Lint only the sources oxlint handles, and only fail on errors: the repo
# carries pre-existing warnings and CI does not fail on those either.
lintable=$(printf '%s\n' "$staged" | grep -E '\.(ts|tsx|mts|cts|js|jsx|mjs)$' || true)
[ -z "$lintable" ] && exit 0

printf '%s\n' "$lintable" | tr '\n' '\0' | xargs -0 "$lint" --quiet || {
	echo "pre-commit: oxlint reported errors; fix them or commit with --no-verify" >&2
	exit 1
}
